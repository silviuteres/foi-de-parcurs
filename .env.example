# Copiați în .env.local (local) și în Vercel → Settings → Environment Variables
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cheia-publica-anon
# Cheia secretă: doar pe server (Vercel), niciodată în browser
SUPABASE_SERVICE_ROLE_KEY=cheia-service-role
# Un șir aleator lung; Vercel îl trimite la sarcina lunară
CRON_SECRET=un-sir-aleator-lung
